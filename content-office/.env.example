# ───────────── AI 콘텐츠 오피스 환경 변수 ─────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# API 키는 서버에서만 읽히며 브라우저로 전송되지 않습니다.

# 1) 데이터베이스
# 비워두면 내장 PostgreSQL(PGlite)을 ./data/pglite 에 저장합니다 (설치 불필요).
# Supabase/PostgreSQL 사용 시: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# 2) AI 공식 API 키 (연결할 서비스만 입력)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# 3) 트렌드 데이터 (선택) - 네이버 데이터랩 검색어 트렌드 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 4) 접속 비밀번호 (선택) - 외부 배포 시 반드시 설정하세요
APP_PASSWORD=
